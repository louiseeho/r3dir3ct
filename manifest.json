{
  "manifest_version": 3,
  "name": "r3dir3ct",
  "version": "1.0.0",
  "description": "r3dir3ct blocks distracting websites and redirects you to a random problem instead.",
  "permissions": ["declarativeNetRequest", "storage", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "r3dir3ct"
  }
}
